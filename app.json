{
  "expo": {
    "name": "tpfinal-apps",
    "slug": "tpfinal-apps",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "tpfinalapps",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.molidev.tpfinalapps"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/icono-splash.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#a55890",
          "image": "./assets/images/icono-splash.png",
          "imageWidth": 180
        }
      ],
      "expo-secure-store",
      "expo-camera",
      "expo-location",
      "expo-notifications",
      "expo-video",
      "expo-sqlite",
      "expo-image",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
